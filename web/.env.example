# Shared Neon Postgres Database (Mobile Laravel API + Next.js Web App)
# Pooled connection string for serverless Route Handlers:
DATABASE_URL="postgresql://neondb_owner:password@ep-example-pooler.us-west-2.aws.neon.tech/neondb?sslmode=require"
# Direct (unpooled) connection string for Drizzle migrations & Laravel:
DIRECT_URL="postgresql://neondb_owner:password@ep-example.us-west-2.aws.neon.tech/neondb?sslmode=require"

# Session signing secret (generate with `openssl rand -hex 32`)
SESSION_SECRET="replace-with-at-least-32-bytes-of-random-hex-secret"

# Optional external API origin if proxying to separate backend
NEXT_PUBLIC_API_ORIGIN=""
